<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SDK: loaded into the 32-bit game by HomefrontModLoader (msimg32.dll). Generated\ holds the game
       classes written by HomefrontSDK.Generator from api-reference.json (Build.ps1 regenerates it when that changes). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <RootNamespace>HomefrontSDK</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- A library the loader starts through hostfxr: needs HomefrontSDK.runtimeconfig.json. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RollForward>LatestMinor</RollForward>
    <Version>0.1.0</Version>
    <!-- Generated code: hidden inherited members (overrides of script functions/properties), missing docs. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS1591</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The NuGet package mods build against, published to GitHub Packages by .github/workflows/build.yml on a v* tag. -->
  <PropertyGroup>
    <PackageId>HomefrontSDK</PackageId>
    <Authors>TylerJaacks</Authors>
    <Description>C# modding SDK for the Homefront dedicated server. Reference with ExcludeAssets="runtime": the game already has the SDK loaded.</Description>
    <RepositoryUrl>https://github.com/TylerJaacks/HomefrontSDK</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
