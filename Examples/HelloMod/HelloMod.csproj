<Project Sdk="Microsoft.NET.Sdk">

  <!-- The smallest mod: a starting point for new ones. Build.ps1 installs it as Mods\HelloMod\HelloMod.dll. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The game already has the SDK loaded: reference it, don't copy it. -->
    <ProjectReference Include="..\..\SDK\HomefrontSDK.csproj" Private="false" />
  </ItemGroup>

</Project>
